{
  "version": 6,
  "configurePresets": [
    {
      "name": "ucrt64",
      "displayName": "MSYS2 UCRT64",
      "description": "Ninja with the GCC toolchain in C:/msys64/ucrt64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ucrt64",
      "configurePreset": "ucrt64"
    }
  ]
}
